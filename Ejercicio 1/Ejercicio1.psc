Algoritmo Ejercio1
	//Se definen las variables.
	Definir base,altura,area,perimetro Como Real
	
	//Se solicitan los datos.
	Escribir "Ingrese el valor de Base"
	Leer base
	Escribir "Ingrese el valor de Altura"
	Leer altura
	
	//Formulas para calcular la informacion.
	area <- base*altura
	perimetro <- base+base+altura+altura
	
	//Se imprimen la informacion requerida.
	Escribir "El valor de area es: ",area
	Escribir "El valor de perimetro es: ",perimetro
	
FinAlgoritmo
